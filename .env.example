# ElectroDash server. Copy to .env for local development (never commit .env).

# Railway sets this automatically when you attach its PostgreSQL service.
# Leave unset locally to use the embedded database in ./.data
# DATABASE_URL=postgresql://user:password@host:5432/railway

# Required in production: a long random string (e.g. `openssl rand -base64 48`).
# JWT_SECRET=

PORT=4000
# NODE_ENV=production

# OTP delivery: `console` (this PC only — code shown in the log/app), `test` (live server while the
# app is being built — same, no SMS, anyone can log in to any number), `messagecentral` (real SMS,
# no DLT registration of our own needed) or `msg91` (real SMS, needs our DLT template).
OTP_PROVIDER=console
# MESSAGECENTRAL_CUSTOMER_ID=
# MESSAGECENTRAL_PASSWORD=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Comma-separated browser origins allowed to call the API (admin panel). Native apps don't need this.
CORS_ORIGINS=*

# Secret for the Wall2Roof admin integration API (/v1/integration), at least 32 characters.
# Same value as ELECTRODASH_ADMIN_KEY in the Wall2Roof .env. Unset = integration API answers 503.
# WALL2ROOF_ADMIN_KEY=

# Email alerts: staff get an email for each new order and Contact us message, sent over HTTPS
# (Railway blocks SMTP). ALERT_EMAIL_TO is comma-separated. Neither way below set up, or no
# recipients = no email. Resend wins when both are set.
# 1) Resend (resend.com): RESEND_API_KEY; MAIL_FROM is its sender (Resend only). onboarding@resend.dev
#    only sends to the Resend account's own email; verify a domain there to send to more people.
# 2) The relay: the Wall2Roof app on Cloudways sends with its own mail settings, from its
#    MAIL_FROM_ADDRESS. MAIL_RELAY_URL must be https://; MAIL_RELAY_KEY = the same value as
#    ELECTRODASH_API_KEY on Cloudways; each ALERT_EMAIL_TO address must also be in Wall2Roof's
#    ELECTRODASH_ALERT_EMAILS.
# RESEND_API_KEY=
# MAIL_FROM=ElectroDash <onboarding@resend.dev>
# MAIL_RELAY_URL=https://<wall2roof-domain>/api/electrodash/mail
# MAIL_RELAY_KEY=
# ALERT_EMAIL_TO=vivek@matridtech.com
